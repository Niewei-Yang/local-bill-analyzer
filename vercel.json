{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["sin1"],
  "buildCommand": "",
  "installCommand": "",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{data/**,tests/**,scripts/**,.git/**,.vercel/**,.venv/**,.env*,**/__pycache__/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
